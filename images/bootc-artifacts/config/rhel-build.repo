# Internal RHEL 10 repos used ONLY at image build time (TFT-4795).
#
# The images.paas.redhat.com bootc base ships without enabled repos and the
# build host is not subscription-registered, so dnf has no content. This file
# is copied in before `dnf install` and removed again in the same build, so it
# does NOT ship in the final image.
#
# Devel mirror (reachable on the Red Hat VPN). x86_64 only - the local build
# targets the host arch. TODO(TFT-4795): parametrise arch / bump compose for
# arm64 AMIs if needed.

[rhel-BaseOS]
name=rhel-BaseOS
baseurl=http://download.devel.redhat.com/rhel-10/composes/RHEL-10/RHEL-10.0-20240917.0/compose/BaseOS/x86_64/os/
enabled=1
gpgcheck=0

[rhel-AppStream]
name=rhel-AppStream
baseurl=http://download.devel.redhat.com/rhel-10/composes/RHEL-10/RHEL-10.0-20240917.0/compose/AppStream/x86_64/os/
enabled=1
gpgcheck=0

[rhel-CRB]
name=rhel-CRB
baseurl=http://download.devel.redhat.com/rhel-10/composes/RHEL-10/RHEL-10.0-20240917.0/compose/CRB/x86_64/os/
enabled=1
gpgcheck=0
