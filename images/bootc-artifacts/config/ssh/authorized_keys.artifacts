# Upload key(s) for the Testing Farm Red Hat ranch artifacts uploader.
# TFT-4795.
#
# Each key is pinned to an rrsync forced command: write-only into /mnt/s3files,
# no shell, no port forwarding. Replace the placeholder below with the real
# public key once available (TFT-4795 open item).
#
# Format:
# command="/usr/bin/rrsync -wo /mnt/s3files",restrict <key-type> <key> <comment>
command="/usr/bin/rrsync -wo /mnt/s3files",restrict ssh-rsa  tft@redhat.com
