#!/bin/bash
# Render non-secret image build inputs; never mount storage during a build.
set -euo pipefail

if [ "$#" -ne 2 ]; then
    echo "Usage: $0 FILESYSTEM_ID MOUNT_TARGET_IP" >&2
    exit 2
fi

filesystem_id=$1
mount_target_ip=$2
if [[ ! "$filesystem_id" =~ ^fs-([0-9a-f]{8}|[0-9a-f]{17})$ ]]; then
    echo "Invalid S3 Files filesystem ID: $filesystem_id" >&2
    exit 1
fi
if [[ ! "$mount_target_ip" =~ ^[0-9]{1,3}(\.[0-9]{1,3}){3}$ ]]; then
    echo "Invalid IPv4 mount-target address: $mount_target_ip" >&2
    exit 1
fi
IFS=. read -r -a octets <<< "$mount_target_ip"
for octet in "${octets[@]}"; do
    if [[ "$octet" == 0* && "$octet" != 0 ]] || (( 10#$octet > 255 )); then
        echo "Invalid IPv4 mount-target address: $mount_target_ip" >&2
        exit 1
    fi
done

printf '%s:/ /var/mnt/s3files s3files _netdev,nofail,x-systemd.automount,mounttargetip=%s 0 0\n' \
    "$filesystem_id" "$mount_target_ip"
