#!/bin/bash
# OpenSSH passes SSH_ORIGINAL_COMMAND to the vendor rrsync implementation.
set -euo pipefail

# Do not let the upload user's environment select a readiness checker or rsync.
export PATH=/usr/sbin:/usr/bin:/sbin:/bin
if [ "$#" -ne 1 ]; then
    echo "Usage: $0 MOUNT_POINT" >&2
    exit 2
fi
script_dir=$(cd -- "$(dirname -- "$0")" && pwd)
"$script_dir/check-artifacts-mount" "$1"
exec /usr/bin/rrsync -wo "$1"
