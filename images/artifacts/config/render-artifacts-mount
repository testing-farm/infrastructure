#!/bin/bash
# Render the var-mnt-s3files.mount unit from non-secret image build inputs.
# bootc install replaces the active /etc/fstab, so the mount must be a baked
# systemd unit rather than an fstab entry (TFT-4795). Never mount during a build.
set -euo pipefail

if [ "$#" -ne 2 ]; then
    echo "Usage: $0 FILESYSTEM_ID MOUNT_TARGET_IP" >&2
    exit 2
fi

filesystem_id=$1
mount_target_ip=$2
if [[ ! "$filesystem_id" =~ ^fs-([0-9a-f]{8}|[0-9a-f]{17})$ ]]; then
    echo "Invalid S3 Files filesystem ID: $filesystem_id" >&2
    exit 1
fi
if [[ ! "$mount_target_ip" =~ ^[0-9]{1,3}(\.[0-9]{1,3}){3}$ ]]; then
    echo "Invalid IPv4 mount-target address: $mount_target_ip" >&2
    exit 1
fi
IFS=. read -r -a octets <<< "$mount_target_ip"
for octet in "${octets[@]}"; do
    if [[ "$octet" == 0* && "$octet" != 0 ]] || (( 10#$octet > 255 )); then
        echo "Invalid IPv4 mount-target address: $mount_target_ip" >&2
        exit 1
    fi
done

cat <<UNIT
[Unit]
Description=Testing Farm artifacts S3 Files storage
After=network-online.target
Wants=network-online.target

[Mount]
What=${filesystem_id}:/
Where=/var/mnt/s3files
Type=s3files
Options=_netdev,nofail,mounttargetip=${mount_target_ip}

[Install]
WantedBy=remote-fs.target
UNIT
