#!/bin/bash
# Mount the artifact storage read-only. Run by artifacts-storage.service at boot.
#
# The S3 Files filesystem ID and mount-target IP are terragrunt outputs
# (terragrunt/modules/artifacts-storage) and reach the instance as EC2 user data:
# cloud-init writes them to /etc/sysconfig/artifacts-storage, which the service
# loads. They do not exist when the image builds, and bootc install replaces the
# active /etc/fstab, so neither a baked mount unit nor fstab can carry them.
# Workers upload to the bucket directly and nothing on this host writes, hence ro.
set -euo pipefail

mount_point=/var/mnt/s3files
filesystem_id=${ARTIFACTS_FILESYSTEM_ID:?Missing ARTIFACTS_FILESYSTEM_ID}
mount_target_ip=${ARTIFACTS_MOUNT_TARGET_IP:?Missing ARTIFACTS_MOUNT_TARGET_IP}

if [[ ! "$filesystem_id" =~ ^fs-([0-9a-f]{8}|[0-9a-f]{17})$ ]]; then
    echo "Invalid S3 Files filesystem ID: $filesystem_id" >&2
    exit 1
fi
if [[ ! "$mount_target_ip" =~ ^[0-9]{1,3}(\.[0-9]{1,3}){3}$ ]]; then
    echo "Invalid IPv4 mount-target address: $mount_target_ip" >&2
    exit 1
fi
IFS=. read -r -a octets <<< "$mount_target_ip"
for octet in "${octets[@]}"; do
    if [[ "$octet" == 0* && "$octet" != 0 ]] || (( 10#$octet > 255 )); then
        echo "Invalid IPv4 mount-target address: $mount_target_ip" >&2
        exit 1
    fi
done

if ! mountpoint -q "$mount_point"; then
    mount -t s3files -o "_netdev,ro,mounttargetip=${mount_target_ip}" \
        "${filesystem_id}:/" "$mount_point"
fi
exec /usr/local/libexec/check-artifacts-mount "$mount_point"
