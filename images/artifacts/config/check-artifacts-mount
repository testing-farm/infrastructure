#!/bin/bash
# Succeed only if the given path is itself an NFSv4 mount. The s3files mount
# helper mounts NFSv4, so findmnt reports nfs4.
set -euo pipefail

mount_point=${1:?Usage: $0 MOUNT_POINT}

fstype=$(findmnt --mountpoint "$mount_point" --noheadings --output FSTYPE || true)
if [ "$fstype" != nfs4 ]; then
    echo "Artifacts storage is not mounted at $mount_point" >&2
    exit 1
fi
