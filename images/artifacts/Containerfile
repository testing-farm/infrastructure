# RHEL 10 image-mode (bootc) artifact storage server.
#
# Serves Testing Farm Red Hat ranch artifacts from an S3 Files (NFS-over-S3)
# mount at /mnt/s3files via nginx autoindex. Workers upload to the S3 bucket
# directly, so the server only reads.
#
# Plan: TFT-4606. Build: TFT-4795. Deployed by: TFT-4797.
ARG BASE_IMAGE=images.paas.redhat.com/testingfarm/rhel-bootc:10
FROM $BASE_IMAGE

# Supplied by build-arg-linux-amd64; configuration, not a credential.
ARG AMAZON_EFS_UTILS_VERSION

COPY config/efs-utils.repo /etc/yum.repos.d/efs-utils.repo

# Storage is mounted at boot from EC2 user data, not baked in.
COPY --chmod=0755 config/mount-artifacts-storage /usr/local/libexec/mount-artifacts-storage
COPY config/artifacts-storage.service /usr/lib/systemd/system/artifacts-storage.service

# Install the storage server, add a placeholder TLS cert, enable the services.
# Kept in a standalone script so it can be linted with shellcheck.
COPY --chmod=0755 setup.sh /tmp/setup.sh
RUN bash /tmp/setup.sh && rm -vf /tmp/setup.sh

# nginx: take over the main config (drops the stock default server) plus our
# autoindex / CORS / HTTP->HTTPS 301 / gzip server blocks.
COPY config/nginx/nginx.conf /etc/nginx/nginx.conf
COPY config/nginx/artifacts.conf /etc/nginx/conf.d/artifacts.conf

# Fail-closed mount check for nginx; administrator SSH has no storage dependency.
COPY --chmod=0755 config/check-artifacts-mount /usr/local/libexec/check-artifacts-mount
COPY config/nginx/10-storage.conf /usr/lib/systemd/system/nginx.service.d/10-storage.conf

# Kernel/network tuning.
COPY config/sysctl-artifacts.conf /usr/lib/sysctl.d/90-artifacts.conf
COPY config/kargs-artifacts.toml /usr/lib/bootc/kargs.d/90-artifacts.toml
