[Unit]
Description=Testing Farm Red Hat ranch worker scaler
Documentation=https://gitlab.com/testing-farm/infrastructure
After=network-online.target nomad.service
Wants=network-online.target

[Service]
Type=simple
User=root
# boto3 and python-nomad are installed in root's user site
Environment=PYTHONUSERBASE=/root/.local
StateDirectory=tf-worker-scaler
ExecStart=/usr/bin/python3 /root/scripts/redhat_worker_scaler.py run
Restart=always
RestartSec=30

[Install]
WantedBy=multi-user.target
