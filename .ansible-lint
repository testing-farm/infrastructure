---
exclude_paths:
  - .gitlab-ci.yml

  # go based tools
  - go

  # goss
  - images/bootc/goss.yaml

  # roles from ansible-galaxy
  - ansible/roles/geerlingguy.node_exporter
  - ansible/roles/geerlingguy.swap

  - tests/worker

  # playbooks using roles from the `testing_farm_profiles` collection,
  # which is installed only on the worker image
  - tests/testing-farm/playbooks

  - terragrunt/environments
