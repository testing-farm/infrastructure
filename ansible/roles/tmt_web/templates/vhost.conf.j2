server {
    listen 80;
    server_name  {{ tmt_web_hostname }};
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    server_name  {{ tmt_web_hostname }};

    ssl_certificate {{ tmt_web_tls_dir }}/fullchain.pem;
    ssl_certificate_key {{ tmt_web_tls_dir }}/privkey.pem;

    add_header Access-Control-Allow-Origin *;
    location / {
{% if tmt_web_frontend == 'gateway' %}
        # The gateway runs on the podman bridge network, 127.0.0.1 is the container itself
        proxy_pass http://{{ ansible_host }}:{{ tmt_web_port }};
{% else %}
        proxy_pass http://127.0.0.1:{{ tmt_web_port }};
{% endif %}
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # Cloning large repositories can take a while
        proxy_read_timeout 300s;
    }
}
