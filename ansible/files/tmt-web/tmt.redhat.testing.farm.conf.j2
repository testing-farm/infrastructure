server {
    listen 80;
    server_name  {{ tmt_web_hostname }};
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    server_name  {{ tmt_web_hostname }};

    ssl_certificate /etc/nginx/tmt-web/tls/fullchain.pem;
    ssl_certificate_key /etc/nginx/tmt-web/tls/privkey.pem;

    add_header Access-Control-Allow-Origin *;
    location / {
        # The gateway runs on the podman bridge network, 127.0.0.1 is the container itself
        proxy_pass http://{{ ansible_host }}:{{ tmt_web_port }};
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # Cloning large repositories can take a while
        proxy_read_timeout 300s;
    }
}
