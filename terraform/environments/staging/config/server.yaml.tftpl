***REMOVED***

users:
  - name: admin
    role: admin

  - name: artemis
    role: user

ssh-keys:
  ${indent(2, yamlencode(ssh_keys))}

priority-groups:
  - name: default-priority

guest_tags:
  FedoraGroup: "ci"
  ServiceName: "Artemis"
  ServiceOwner: "TFT"
  ServicePhase: "Stage"

pools:
  - name: fedora-aws-x86_64
    driver: aws
    parameters:
      access-key-id: "${aws_access_key_id}"
      secret-access-key: "${aws_secret_access_key}"

      default-region: us-east-2

      command: aws
      master-key-name: testing-farm-worker

  ***REMOVED*** set default root disk size to 40GB
      default-root-disk-size: 40

  ***REMOVED*** availability zone match chosen subnet
      availability-zone: us-east-2c

  ***REMOVED*** seems 4k machines
      subnet-id: subnet-4f971734

  ***REMOVED*** security group for test environment
      security-group: "${aws_security_group_id}"

  ***REMOVED*** instance details
      default-instance-type: c6a.large

  ***REMOVED*** wait timeout/tick for fulfilling spot request
  ***REMOVED*** spot-request-timeout: 60
  ***REMOVED*** spot-request-tick: 1

  ***REMOVED*** wait timeout/tick for instance becoming running
  ***REMOVED*** instance-running-timeout: 120
  ***REMOVED*** instance-running-tick: 1

  ***REMOVED*** image owners - Automotive QE and our images
      image-owners:
        - self
        - "587138297281"

      capabilities:
        supports-snapshots: false
        supported-architectures:
          - x86_64

      use-public-ip: true

  - name: fedora-aws-aarch64
    driver: aws
    parameters:
      access-key-id: "${aws_access_key_id}"
      secret-access-key: "${aws_secret_access_key}"

      default-region: us-east-2

      command: aws
      master-key-name: testing-farm-worker

  ***REMOVED*** set default root disk size to 40GB
      default-root-disk-size: 40

  ***REMOVED*** availability zone match chosen subnet
      availability-zone: us-east-2c

  ***REMOVED*** seems 4k machines
      subnet-id: subnet-4f971734

  ***REMOVED*** security group for test environment
      security-group: "${aws_security_group_id}"

  ***REMOVED*** instance details
      default-instance-type: m6g.medium

  ***REMOVED*** wait timeout/tick for fulfilling spot request
  ***REMOVED***spot-request-timeout: 60
  ***REMOVED***spot-request-tick: 1

  ***REMOVED*** wait timeout/tick for instance becoming running
  ***REMOVED***instance-running-timeout: 120
  ***REMOVED***instance-running-tick: 1

  ***REMOVED*** image owners - Automotive QE and our images
      image-owners:
        - self
        - "587138297281"

      capabilities:
        supports-snapshots: false
        supported-architectures:
          - aarch64

      use-public-ip: true
