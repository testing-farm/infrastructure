          - additional-disks:
                max-count: 5
                min-size: "10 GiB"
                max-size: "512 GiB"

    - name: g4dn.8xlarge-250
      base: g4dn.8xlarge
      disk:
          - size: "100 GiB"
          - additional-disks:
                max-count: 5
                min-size: "10 GiB"
                max-size: "512 GiB"

    - name: g4dn.8xlarge-500
      base: g4dn.8xlarge
      disk:
          - size: "100 GiB"
          - additional-disks:
                max-count: 5
                min-size: "10 GiB"
                max-size: "512 GiB"

    - name: g4dn.12xlarge-100
      base: g4dn.12xlarge
