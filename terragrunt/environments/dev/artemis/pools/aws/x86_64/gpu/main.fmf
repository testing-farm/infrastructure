patch-flavors:
  # Intel Xeon Platinum 8259CL (Cascade Lake) + NVIDIA T4 GPU - g4dn instances
  - name-regex: 'g4dn\..+'
    gpu:
      device-name: "NVIDIA T4"
      vendor-name: "NVIDIA"
      driver: nvidia

    virtualization:
      is-supported: false
      is-virtualized: true
