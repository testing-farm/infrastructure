# GPU pool common settings

default-flavor: g4dn.2xlarge
flavor-regex: ^g4dn.(xlarge|2xlarge|4xlarge|8xlarge|12xlarge|16xlarge)$

custom-flavors:
    # g4dn (GPU accelerated, NVIDIA T4) - TFT-4657
    - name: g4dn.xlarge-100
      base: g4dn.xlarge
      disk:
          - size: "100 GiB"
          - additional-disks:
                max-count: 5
                min-size: "10 GiB"
                max-size: "512 GiB"

    - name: g4dn.xlarge-250
      base: g4dn.xlarge
      disk:
          - size: "100 GiB"
          - additional-disks:
                max-count: 5
                min-size: "10 GiB"
                max-size: "512 GiB"

    - name: g4dn.xlarge-500
      base: g4dn.xlarge
      disk:
          - size: "100 GiB"
          - additional-disks:
                max-count: 5
                min-size: "10 GiB"
                max-size: "512 GiB"

    - name: g4dn.2xlarge-100
      base: g4dn.2xlarge
      disk:
          - size: "100 GiB"
          - additional-disks:
                max-count: 5
                min-size: "10 GiB"
                max-size: "512 GiB"

    - name: g4dn.2xlarge-250
      base: g4dn.2xlarge
      disk:
          - size: "100 GiB"
          - additional-disks:
                max-count: 5
                min-size: "10 GiB"
                max-size: "512 GiB"

    - name: g4dn.2xlarge-500
