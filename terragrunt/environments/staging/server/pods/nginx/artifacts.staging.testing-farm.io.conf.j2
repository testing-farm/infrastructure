# Skip the artifact viewer when clients request a directory listing.
map $arg_list $artifacts_index {
    default index.html;
    true __directory_listing__;
}

server {
    listen 80;
    server_name  artifacts{{ staging_ci_suffix | default('') }}.{{ 'staging-ci' if staging_ci_suffix is defined else 'staging' }}.testing-farm.io;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    server_name  artifacts{{ staging_ci_suffix | default('') }}.{{ 'staging-ci' if staging_ci_suffix is defined else 'staging' }}.testing-farm.io;

    ssl_certificate /etc/ssl/nginx/fullchain.pem;
    ssl_certificate_key /etc/ssl/nginx/privkey.pem;

    add_header Access-Control-Allow-Origin *;

    root /var/artifacts;
    disable_symlinks off;

    location ~ "^.*\.txt\.gz$" {
        root /archive;
        types { } default_type "text/plain gz";
        add_header  Content-Encoding  gzip;
        gzip off;
        rewrite "^(.*)$" $1 break;
    }

    location ~ "^/.*/" {
        index $artifacts_index;
        autoindex on;
    }
}
