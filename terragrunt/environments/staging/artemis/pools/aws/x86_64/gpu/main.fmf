# GPU pool common settings

default-flavor: g4dn.2xlarge
flavor-regex: ^g4dn.(xlarge|2xlarge|4xlarge|8xlarge|12xlarge|16xlarge)$

custom-flavors:
    # g4dn (GPU accelerated, NVIDIA T4) - TFT-4657
    - g4dn.xlarge
    - g4dn.2xlarge
    - g4dn.4xlarge
    - g4dn.8xlarge
    - g4dn.12xlarge
    - g4dn.16xlarge

patch-flavors:
  # Intel Xeon Platinum 8259CL (Cascade Lake) + NVIDIA T4 GPU - g4dn instances
  - name-regex: 'g4dn\..+'
    gpu:
      device-name: "NVIDIA T4"
      vendor-name: "NVIDIA"
      driver: nvidia

    virtualization:
      is-supported: false
      is-virtualized: true
