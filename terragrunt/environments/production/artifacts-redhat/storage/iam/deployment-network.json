{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadNetwork",
      "Effect": "Allow",
      "Action": [
        "ec2:DescribeSubnets", "ec2:DescribeVpcs", "ec2:DescribeAvailabilityZones",
        "ec2:DescribeSecurityGroups", "ec2:DescribeSecurityGroupRules",
        "ec2:DescribeNetworkInterfaces", "ec2:DescribeNetworkInterfaceAttribute", "ec2:DescribeTags"
      ],
      "Resource": "*",
      "Condition": {"StringEquals": {"aws:RequestedRegion": "us-east-1"}}
    },
    {
      "Sid": "CreateTaggedSecurityGroups",
      "Effect": "Allow",
      "Action": "ec2:CreateSecurityGroup",
      "Resource": "arn:aws:ec2:us-east-1:727920394381:security-group/*",
      "Condition": {
        "StringEquals": {"aws:RequestTag/StorageBackend": "testing-farm-artifacts-redhat"}
      }
    },
    {
      "Sid": "CreateSecurityGroupsInApprovedVpc",
      "Effect": "Allow",
      "Action": "ec2:CreateSecurityGroup",
      "Resource": "arn:aws:ec2:us-east-1:727920394381:vpc/vpc-008152fcfb0333f30"
    },
    {
      "Sid": "TagSecurityGroupsOnCreation",
      "Effect": "Allow",
      "Action": "ec2:CreateTags",
      "Resource": "arn:aws:ec2:us-east-1:727920394381:security-group/*",
      "Condition": {
        "StringEquals": {
          "ec2:CreateAction": "CreateSecurityGroup",
          "aws:RequestTag/StorageBackend": "testing-farm-artifacts-redhat"
        }
      }
    },
    {
      "Sid": "ManageOwnedSecurityGroups",
      "Effect": "Allow",
      "Action": [
        "ec2:DeleteSecurityGroup", "ec2:AuthorizeSecurityGroupIngress", "ec2:AuthorizeSecurityGroupEgress",
        "ec2:RevokeSecurityGroupIngress", "ec2:RevokeSecurityGroupEgress",
        "ec2:UpdateSecurityGroupRuleDescriptionsIngress", "ec2:UpdateSecurityGroupRuleDescriptionsEgress"
      ],
      "Resource": "arn:aws:ec2:us-east-1:727920394381:security-group/*",
      "Condition": {
        "StringEquals": {"ec2:ResourceTag/StorageBackend": "testing-farm-artifacts-redhat"},
        "ArnEquals": {"ec2:Vpc": "arn:aws:ec2:us-east-1:727920394381:vpc/vpc-008152fcfb0333f30"}
      }
    },
    {
      "Sid": "UpdateNonAuthorizationSecurityGroupTags",
      "Effect": "Allow",
      "Action": ["ec2:CreateTags", "ec2:DeleteTags"],
      "Resource": "arn:aws:ec2:us-east-1:727920394381:security-group/*",
      "Condition": {
        "StringEquals": {"ec2:ResourceTag/StorageBackend": "testing-farm-artifacts-redhat"},
        "ForAllValues:StringNotEqualsIgnoreCase": {"aws:TagKeys": ["StorageBackend"]}
      }
    },
    {
      "Sid": "CreateMountTargetInterfaces",
      "Effect": "Allow",
      "Action": "ec2:CreateNetworkInterface",
      "Resource": "arn:aws:ec2:us-east-1:727920394381:network-interface/*"
    },
    {
      "Sid": "UseApprovedSubnet",
      "Effect": "Allow",
      "Action": ["ec2:CreateNetworkInterface", "ec2:ModifyNetworkInterfaceAttribute"],
      "Resource": "arn:aws:ec2:us-east-1:727920394381:subnet/subnet-036ad213c3fb0eb7e"
    },
    {
      "Sid": "UseOwnedInterfaceSecurityGroups",
      "Effect": "Allow",
      "Action": ["ec2:CreateNetworkInterface", "ec2:ModifyNetworkInterfaceAttribute"],
      "Resource": "arn:aws:ec2:us-east-1:727920394381:security-group/*",
      "Condition": {
        "StringEquals": {"ec2:ResourceTag/StorageBackend": "testing-farm-artifacts-redhat"},
        "ArnEquals": {"ec2:Vpc": "arn:aws:ec2:us-east-1:727920394381:vpc/vpc-008152fcfb0333f30"}
      }
    },
    {
      "Sid": "ManageInterfacesInApprovedSubnet",
      "Effect": "Allow",
      "Action": ["ec2:ModifyNetworkInterfaceAttribute", "ec2:DeleteNetworkInterface"],
      "Resource": "arn:aws:ec2:us-east-1:727920394381:network-interface/*",
      "Condition": {
        "ArnEquals": {"ec2:Subnet": "arn:aws:ec2:us-east-1:727920394381:subnet/subnet-036ad213c3fb0eb7e"}
      }
    }
  ]
}
