{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "CreateBoundedRoles",
      "Effect": "Allow",
      "Action": ["iam:CreateRole", "iam:PutRolePermissionsBoundary"],
      "Resource": [
        "arn:aws:iam::727920394381:role/testing-farm-artifacts-redhat-s3files-service-role",
        "arn:aws:iam::727920394381:role/testing-farm-artifacts-redhat-ec2-client-role"
      ],
      "Condition": {
        "StringEquals": {
          "iam:PermissionsBoundary": "arn:aws:iam::727920394381:policy/arr-testing-farm.prod.role-boundary"
        }
      }
    },
    {
      "Sid": "ManageBoundedRolePolicies",
      "Effect": "Allow",
      "Action": ["iam:PutRolePolicy", "iam:UpdateAssumeRolePolicy"],
      "Resource": [
        "arn:aws:iam::727920394381:role/testing-farm-artifacts-redhat-s3files-service-role",
        "arn:aws:iam::727920394381:role/testing-farm-artifacts-redhat-ec2-client-role"
      ],
      "Condition": {
        "StringEquals": {
          "iam:PermissionsBoundary": "arn:aws:iam::727920394381:policy/arr-testing-farm.prod.role-boundary"
        }
      }
    },
    {
      "Sid": "ManageRoleLifecycle",
      "Effect": "Allow",
      "Action": [
        "iam:GetRole", "iam:DeleteRole", "iam:UpdateRole", "iam:UpdateRoleDescription",
        "iam:GetRolePolicy", "iam:DeleteRolePolicy", "iam:ListRolePolicies",
        "iam:ListAttachedRolePolicies", "iam:ListInstanceProfilesForRole",
        "iam:TagRole", "iam:UntagRole", "iam:ListRoleTags"
      ],
      "Resource": [
        "arn:aws:iam::727920394381:role/testing-farm-artifacts-redhat-s3files-service-role",
        "arn:aws:iam::727920394381:role/testing-farm-artifacts-redhat-ec2-client-role"
      ]
    },
    {
      "Sid": "DetachLegacyClientPolicy",
      "Effect": "Allow",
      "Action": "iam:DetachRolePolicy",
      "Resource": "arn:aws:iam::727920394381:role/testing-farm-artifacts-redhat-ec2-client-role",
      "Condition": {
        "ArnEquals": {
          "iam:PolicyARN": "arn:aws:iam::aws:policy/AmazonS3FilesClientFullAccess"
        },
        "StringEquals": {
          "iam:PermissionsBoundary": "arn:aws:iam::727920394381:policy/arr-testing-farm.prod.role-boundary"
        }
      }
    },
    {
      "Sid": "ManageInstanceProfile",
      "Effect": "Allow",
      "Action": [
        "iam:CreateInstanceProfile", "iam:GetInstanceProfile", "iam:DeleteInstanceProfile",
        "iam:AddRoleToInstanceProfile", "iam:RemoveRoleFromInstanceProfile",
        "iam:TagInstanceProfile", "iam:UntagInstanceProfile", "iam:ListInstanceProfileTags"
      ],
      "Resource": "arn:aws:iam::727920394381:instance-profile/testing-farm-artifacts-redhat-instance-profile"
    },
    {
      "Sid": "PassServiceRole",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": "arn:aws:iam::727920394381:role/testing-farm-artifacts-redhat-s3files-service-role",
      "Condition": {
        "StringEquals": {"iam:PassedToService": "elasticfilesystem.amazonaws.com"}
      }
    },
    {
      "Sid": "PassClientRole",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": "arn:aws:iam::727920394381:role/testing-farm-artifacts-redhat-ec2-client-role",
      "Condition": {
        "StringEquals": {"iam:PassedToService": "ec2.amazonaws.com"}
      }
    },
    {
      "Sid": "DenyMissingOrDifferentBoundary",
      "Effect": "Deny",
      "Action": ["iam:CreateRole", "iam:PutRolePermissionsBoundary"],
      "Resource": [
        "arn:aws:iam::727920394381:role/testing-farm-artifacts-redhat-s3files-service-role",
        "arn:aws:iam::727920394381:role/testing-farm-artifacts-redhat-ec2-client-role"
      ],
      "Condition": {
        "StringNotEquals": {
          "iam:PermissionsBoundary": "arn:aws:iam::727920394381:policy/arr-testing-farm.prod.role-boundary"
        }
      }
    },
    {
      "Sid": "DenyBoundaryRemoval",
      "Effect": "Deny",
      "Action": "iam:DeleteRolePermissionsBoundary",
      "Resource": [
        "arn:aws:iam::727920394381:role/testing-farm-artifacts-redhat-s3files-service-role",
        "arn:aws:iam::727920394381:role/testing-farm-artifacts-redhat-ec2-client-role"
      ]
    },
    {
      "Sid": "DenyBoundaryPolicyMutation",
      "Effect": "Deny",
      "Action": [
        "iam:CreatePolicyVersion", "iam:SetDefaultPolicyVersion",
        "iam:DeletePolicyVersion", "iam:DeletePolicy"
      ],
      "Resource": "arn:aws:iam::727920394381:policy/arr-testing-farm.prod.role-boundary"
    }
  ]
}
