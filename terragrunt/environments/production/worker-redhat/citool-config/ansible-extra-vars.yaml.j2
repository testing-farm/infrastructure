---
{% if GUEST is defined %}
UPDATE_FROM_ARTIFACTS: {{ ((GUEST.environment.pipeline | default({})).settings | default({})).update_from_artifacts | default(False) | tojson }}

GUEST:
  {% if GUEST.artemis_id %}
  artemis_id: "{{ GUEST.artemis_id }}"
  {% endif %}
{% endif %}

#
# Role variables for Testing Farm profiles
#

#
# AWS Red Hat ranch requires the hostname to be set according to IT AWS setup.
#
# TFT-1803 - AWS hostnames were reimplemented by IT.
# TFT-1987 - Set explicitly as it happens after the machine boots.
#
# The search domain is by default `<REGION>.aws.redhat.com`, e.g. `us-east-1.aws.redhat.com`.
# We cannot set it to FQDN, because hostname can only be 64 chars max:
# https://redhat-internal.slack.com/archives/C03BRN71JAF/p1685450197314049
#
{% if GUEST is defined and GUEST.artemis_id %}
hostname_hostname: "{{ GUEST.artemis_id }}"
{% endif %}

python_bin_url:
  aarch64: "https://testing-farm-public.s3.amazonaws.com/standalone-python/build-aarch64.tar.gz"
  ppc64le: "https://testing-farm-public.s3.amazonaws.com/standalone-python/build-ppc64le.tar.gz"
  s390x: "https://testing-farm-public.s3.amazonaws.com/standalone-python/build-s390x.tar.gz"
  x86_64: "https://testing-farm-public.s3.amazonaws.com/standalone-python/build-x86_64.tar.gz"
  i386: "https://testing-farm-public.s3.amazonaws.com/standalone-python/build-i386.tar.gz"
  ppc64: "https://testing-farm-public.s3.amazonaws.com/standalone-python/build-ppc64.tar.gz"

python_install_path: "/var/opt/standalone-python"
